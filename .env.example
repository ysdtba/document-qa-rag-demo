# LLM 配置（DeepSeek 兼容 OpenAI 接口；留空 Key 则启用 Mock 流式模式）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_CONTEXT_WINDOW=65536
LLM_MAX_TOKENS=2048

# 本地 Embedding / Rerank 模型（首次运行会自动下载，体积较小）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
# mock | local
RERANK_MODE=mock

# 检索参数
TOP_K=10
RERANK_TOP_N=3

# 持久化路径
CHROMA_PATH=./storage/chroma
DOCSTORE_PATH=./storage/docstore
BM25_PATH=./storage/bm25

# 仅在前端与 API 分离部署时配置，例如 https://demo.example.com
CORS_ORIGINS=
