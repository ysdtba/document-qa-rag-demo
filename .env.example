# LLM 配置（DeepSeek 兼容 OpenAI 接口；留空 Key 则启用 Mock 流式模式）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_CONTEXT_WINDOW=65536
LLM_MAX_TOKENS=2048
# 评测要求 temperature=0
LLM_TEMPERATURE=0
# DeepSeek V4 默认开 thinking，thinking 下 temperature 不生效；评测用 disabled
LLM_THINKING=disabled
# 生成模型单价（美元 / 百万 token），评测用来算每题费用；以服务商官网为准
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# 评判模型（任意 OpenAI 兼容接口），不能比生成模型弱；只有 eval/run_eval.py 使用
# JUDGE_API_KEY / JUDGE_BASE_URL 留空时沿用 OPENAI_API_KEY / OPENAI_BASE_URL
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=deepseek-flash
JUDGE_THINKING=disabled
JUDGE_PRICE_INPUT_PER_M=
JUDGE_PRICE_OUTPUT_PER_M=

# 本地 Embedding / Rerank 模型（首次运行会自动下载，体积较小）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base
# local | mock | none（none = 不重排，对照用）
RERANK_MODE=mock
# hybrid | vector | bm25（单路检索用于消融对照）
RETRIEVAL_MODE=hybrid

# 检索参数
TOP_K=20
RERANK_TOP_N=3

# 语料目录：示例 demo 用 docs；年报用 data/raw（元数据来自 data/manifest.csv）
DOCS_DIR=docs
MANIFEST_PATH=data/manifest.csv

# 持久化路径
CHROMA_PATH=./storage/chroma
DOCSTORE_PATH=./storage/docstore
BM25_PATH=./storage/bm25

# 仅在前端与 API 分离部署时配置，例如 https://demo.example.com
CORS_ORIGINS=
